# Ignore everything by default, then whitelist what we track
*

# Config files we want to track
!.gitignore
!.gitattributes
!CLAUDE.md

# Neovim config
!nvim/
!nvim/**

# Tmux config
!tmux/
!tmux/**

# Scripts
!bin/
!bin/**

# Shell config
!zsh/
!zsh/**
!install.sh

# Ignore tmux plugin installs (managed by TPM)
tmux/plugins/

# Agent config: neutral sources plus per-agent adapters
!ai/
!ai/**

# herdr config (keybindings ported from tmux)
!herdr/
!herdr/**

# kanata config (home row mods)
!kanata/
!kanata/**

# Per-agent adapters
!claude/
!claude/**
!opencode/
!opencode/**
!codex/
!codex/**
!gemini/
!gemini/**

# terminal-browser skill is a symlink into ~/.local/share (machine-local install)
ai/skills/terminal-browser

# Ghostty terminal config
!ghostty/
!ghostty/**

# Kitty terminal config
!kitty/
!kitty/**

# Alacritty / foot terminal configs (Omarchy only)
!alacritty/
!alacritty/**
!foot/
!foot/**

# Hyprland personal overrides (Omarchy only).
# monitors.lua is per-machine (output names, scale, panel quirks) -- left
# untracked on purpose; see hypr/hyprland.lua's header.
!hypr/
!hypr/**
hypr/monitors.lua

# Backups install.sh leaves behind when it replaces a real file with a symlink
**/*.bak
**/*.bak.*

# Ignore nvim artifacts and nested git
nvim/.git/
nvim/.git.bak/
nvim/.github/
nvim/.luarc.json
nvim/spell/
nvim/lazy-lock.json
nvim/tags
nvim/test.sh

# Ignore nvim backup
nvim.bak.*

# Ignore github-copilot secrets
github-copilot/

# Ignore macOS cruft
.DS_Store
**/.DS_Store
